{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StackServices",
      "Effect": "Allow",
      "Action": [
        "acm:*",
        "aoss:*",
        "apigateway:*",
        "application-autoscaling:*",
        "apprunner:*",
        "athena:*",
        "autoscaling:*",
        "backup:*",
        "bedrock-agentcore:*",
        "bedrock:*",
        "cloudfront:*",
        "cloudtrail:*",
        "cloudwatch:*",
        "codebuild:*",
        "codedeploy:*",
        "codepipeline:*",
        "cognito-idp:*",
        "dynamodb:*",
        "ec2:*",
        "ecs:*",
        "eks:*",
        "elasticache:*",
        "elasticfilesystem:*",
        "elasticloadbalancing:*",
        "es:*",
        "events:*",
        "glue:*",
        "kafka:*",
        "kendra:*",
        "kinesis:*",
        "kms:*",
        "lambda:*",
        "logs:*",
        "rds:*",
        "redshift:*",
        "resource-explorer-2:*",
        "route53:*",
        "s3:*",
        "s3vectors:*",
        "sagemaker:*",
        "secretsmanager:*",
        "servicediscovery:*",
        "sns:*",
        "sqs:*",
        "ssm:*",
        "states:*",
        "wafv2:*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "CallerIdentity",
      "Effect": "Allow",
      "Action": [
        "sts:GetCallerIdentity"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "IAMRead",
      "Effect": "Allow",
      "Action": [
        "iam:Get*",
        "iam:List*"
      ],
      "Resource": [
        "*"
      ]
    },
    {
      "Sid": "CreateProjectRolesWithWorkloadBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole"
      ],
      "Resource": [
        "arn:*:iam::*:role/insideout/${project}/*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${project}",
          "iam:PermissionsBoundary": "${workload_boundary_arn}"
        }
      }
    },
    {
      "Sid": "ChangeProjectRolesWithWorkloadBoundary",
      "Effect": "Allow",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy"
      ],
      "Resource": [
        "arn:*:iam::*:role/insideout/${project}/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PermissionsBoundary": "${workload_boundary_arn}"
        }
      }
    },
    {
      "Sid": "ManageProjectRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:UpdateRole",
        "iam:UpdateRoleDescription"
      ],
      "Resource": [
        "arn:*:iam::*:role/insideout/${project}/*"
      ]
    },
    {
      "Sid": "PassProjectRolesToStackServices",
      "Effect": "Allow",
      "Action": [
        "iam:PassRole"
      ],
      "Resource": [
        "arn:*:iam::*:role/insideout/${project}/*"
      ],
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": [
            "backup.amazonaws.com",
            "bedrock-agentcore.amazonaws.com",
            "bedrock.amazonaws.com",
            "build.apprunner.amazonaws.com",
            "codebuild.amazonaws.com",
            "ec2.amazonaws.com",
            "eks-fargate-pods.amazonaws.com",
            "eks.amazonaws.com",
            "kendra.amazonaws.com",
            "lambda.amazonaws.com",
            "monitoring.rds.amazonaws.com",
            "pods.eks.amazonaws.com",
            "sagemaker.amazonaws.com",
            "tasks.apprunner.amazonaws.com",
            "vpc-flow-logs.amazonaws.com"
          ]
        }
      }
    },
    {
      "Sid": "ProjectPolicies",
      "Effect": "Allow",
      "Action": [
        "iam:CreatePolicy",
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion",
        "iam:TagPolicy",
        "iam:UntagPolicy"
      ],
      "Resource": [
        "arn:*:iam::*:policy/insideout/${project}/*"
      ]
    },
    {
      "Sid": "ProjectInstanceProfiles",
      "Effect": "Allow",
      "Action": [
        "iam:AddRoleToInstanceProfile",
        "iam:CreateInstanceProfile",
        "iam:DeleteInstanceProfile",
        "iam:RemoveRoleFromInstanceProfile",
        "iam:TagInstanceProfile",
        "iam:UntagInstanceProfile"
      ],
      "Resource": [
        "arn:*:iam::*:instance-profile/insideout/${project}/*"
      ]
    },
    {
      "Sid": "CreateEKSOIDCProviderForProject",
      "Effect": "Allow",
      "Action": [
        "iam:CreateOpenIDConnectProvider"
      ],
      "Resource": [
        "arn:*:iam::*:oidc-provider/oidc.eks.*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:RequestTag/Project": "${project}"
        }
      }
    },
    {
      "Sid": "TagNewEKSOIDCProviderForProject",
      "Effect": "Allow",
      "Action": [
        "iam:TagOpenIDConnectProvider"
      ],
      "Resource": [
        "arn:*:iam::*:oidc-provider/oidc.eks.*"
      ],
      "Condition": {
        "Null": {
          "aws:ResourceTag/Project": "true"
        },
        "StringEquals": {
          "aws:RequestTag/Project": "${project}"
        }
      }
    },
    {
      "Sid": "ChangeProjectEKSOIDCProviders",
      "Effect": "Allow",
      "Action": [
        "iam:AddClientIDToOpenIDConnectProvider",
        "iam:DeleteOpenIDConnectProvider",
        "iam:RemoveClientIDFromOpenIDConnectProvider",
        "iam:TagOpenIDConnectProvider",
        "iam:UntagOpenIDConnectProvider",
        "iam:UpdateOpenIDConnectProviderThumbprint"
      ],
      "Resource": [
        "arn:*:iam::*:oidc-provider/oidc.eks.*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "${project}"
        }
      }
    },
    {
      "Sid": "CreateServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:CreateServiceLinkedRole"
      ],
      "Resource": [
        "arn:*:iam::*:role/aws-service-role/*"
      ]
    },
    {
      "Sid": "DeletePresetServiceLinkedRoles",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteServiceLinkedRole"
      ],
      "Resource": [
        "arn:*:iam::*:role/aws-service-role/eks-nodegroup.amazonaws.com/*",
        "arn:*:iam::*:role/aws-service-role/kafka.amazonaws.com/*",
        "arn:*:iam::*:role/aws-service-role/observability.aoss.amazonaws.com/*",
        "arn:*:iam::*:role/aws-service-role/opensearchservice.amazonaws.com/*"
      ]
    },
    {
      "Sid": "TeardownLegacyProjectIAM",
      "Effect": "Allow",
      "Action": [
        "iam:DeleteInstanceProfile",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:DeleteRole",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:RemoveRoleFromInstanceProfile"
      ],
      "Resource": [
        "*"
      ],
      "Condition": {
        "StringEquals": {
          "aws:ResourceTag/Project": "${project}"
        }
      }
    },
    {
      "Sid": "DenyEditOwnPolicies",
      "Effect": "Deny",
      "Action": [
        "iam:CreatePolicyVersion",
        "iam:DeletePolicy",
        "iam:DeletePolicyVersion",
        "iam:SetDefaultPolicyVersion"
      ],
      "Resource": [
        "${deploy_policy_arn}",
        "${workload_boundary_arn}"
      ]
    },
    {
      "Sid": "DenyEditDeployRole",
      "Effect": "Deny",
      "Action": [
        "iam:AttachRolePolicy",
        "iam:DeleteRole",
        "iam:DeleteRolePermissionsBoundary",
        "iam:DeleteRolePolicy",
        "iam:DetachRolePolicy",
        "iam:PutRolePermissionsBoundary",
        "iam:PutRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy"
      ],
      "Resource": [
        "${deploy_role_arn}"
      ]
    },
    {
      "Sid": "DenyBoundaryRemoval",
      "Effect": "Deny",
      "Action": [
        "iam:DeleteRolePermissionsBoundary"
      ],
      "Resource": [
        "*"
      ]
    }
  ]
}
